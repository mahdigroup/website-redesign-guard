{
  "name": "website-redesign-guard",
  "version": "1.0.0",
  "description": "Read-only website redesign checks: compare snapshots, redirects, indexability and enquiry journeys. By Essex Website Builders.",
  "type": "module",
  "engines": {"node": ">=22"},
  "bin": {"redesign-guard": "bin/guard.js"},
  "exports": {".": "./src/compare.js", "./report": "./src/report.js"},
  "files": ["bin/", "src/", "demo/", "examples/", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {"test": "node --test test/*.test.js", "build": "node scripts/build-demo.mjs", "demo": "node scripts/serve-demo.mjs", "check": "npm test && npm run build"},
  "repository": {"type": "git", "url": "https://github.com/mahdigroup/website-redesign-guard.git"},
  "homepage": "https://essexwebsitebuilders.co.uk/tools/website-redesign-guard/",
  "author": "Essex Website Builders <info@essexwebsitebuilders.co.uk>",
  "license": "MIT",
  "keywords": ["wordpress", "website-redesign", "seo", "migration", "redirects", "website-audit"],
  "dependencies": {"ipaddr.js": "2.5.0", "linkedom": "0.18.14", "robots-parser": "3.0.1"},
  "devDependencies": {"esbuild": "0.25.12", "playwright": "1.62.1", "@axe-core/playwright": "4.10.2"}
}
